<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sudoku.App.ViewModels"
             x:Class="Sudoku.App.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*" Padding="24,16">
        <Image Source="{AppThemeBinding Light=sakura_branch_light.png, Dark=sakura_branch_dark.png}"
               Grid.RowSpan="2"
               InputTransparent="True"
               Aspect="AspectFit"
               HorizontalOptions="End"
               VerticalOptions="Start"
               WidthRequest="320"
               HeightRequest="480" />

        <HorizontalStackLayout Spacing="12">
            <Button Text="&#9664;" BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#8a7e74, Dark=#7a7068}"
                    FontSize="18" Clicked="OnBackClicked" />
            <Label Text="Settings" FontSize="22" FontAttributes="Bold"
                   VerticalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#3d3632, Dark=#e0d8cf}" />
        </HorizontalStackLayout>

        <ScrollView Grid.Row="1" Margin="0,16,0,0">
            <VerticalStackLayout Spacing="0">
                <Label Text="APPEARANCE" FontSize="11" CharacterSpacing="2" TextColor="#7d8c6e" Margin="0,0,0,12" />

                <Grid ColumnDefinitions="*,Auto" Padding="0,14">
                    <VerticalStackLayout>
                        <Label Text="Dark Theme" FontSize="15"
                               TextColor="{AppThemeBinding Light=#3d3632, Dark=#e0d8cf}" />
                        <Label Text="Toggle between dark and light" FontSize="12"
                               TextColor="{AppThemeBinding Light=#8a7e74, Dark=#7a7068}" />
                    </VerticalStackLayout>
                    <Switch IsToggled="{Binding IsDarkTheme}" OnColor="#7d8c6e"
                            Grid.Column="1" VerticalOptions="Center" />
                </Grid>

                <Label Text="GAMEPLAY" FontSize="11" CharacterSpacing="2" TextColor="#7d8c6e" Margin="0,24,0,12" />

                <Grid ColumnDefinitions="*,Auto" Padding="0,14">
                    <VerticalStackLayout>
                        <Label Text="Highlight Related Cells" FontSize="15"
                               TextColor="{AppThemeBinding Light=#3d3632, Dark=#e0d8cf}" />
                        <Label Text="Shade row, column, and box" FontSize="12"
                               TextColor="{AppThemeBinding Light=#8a7e74, Dark=#7a7068}" />
                    </VerticalStackLayout>
                    <Switch IsToggled="{Binding HighlightRelatedCells}" OnColor="#7d8c6e"
                            Grid.Column="1" VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Padding="0,14">
                    <VerticalStackLayout>
                        <Label Text="Highlight Same Numbers" FontSize="15"
                               TextColor="{AppThemeBinding Light=#3d3632, Dark=#e0d8cf}" />
                        <Label Text="Tint cells with matching value" FontSize="12"
                               TextColor="{AppThemeBinding Light=#8a7e74, Dark=#7a7068}" />
                    </VerticalStackLayout>
                    <Switch IsToggled="{Binding HighlightSameNumbers}" OnColor="#7d8c6e"
                            Grid.Column="1" VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Padding="0,14">
                    <VerticalStackLayout>
                        <Label Text="Show Errors" FontSize="15"
                               TextColor="{AppThemeBinding Light=#3d3632, Dark=#e0d8cf}" />
                        <Label Text="Highlight incorrect values immediately" FontSize="12"
                               TextColor="{AppThemeBinding Light=#8a7e74, Dark=#7a7068}" />
                    </VerticalStackLayout>
                    <Switch IsToggled="{Binding ShowErrors}" OnColor="#7d8c6e"
                            Grid.Column="1" VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Padding="0,14">
                    <VerticalStackLayout>
                        <Label Text="Zen Koans" FontSize="15"
                               TextColor="{AppThemeBinding Light=#3d3632, Dark=#e0d8cf}" />
                        <Label Text="Show a Zen koan before each puzzle" FontSize="12"
                               TextColor="{AppThemeBinding Light=#8a7e74, Dark=#7a7068}" />
                    </VerticalStackLayout>
                    <Switch IsToggled="{Binding ShowKoans}" OnColor="#7d8c6e"
                            Grid.Column="1" VerticalOptions="Center" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
